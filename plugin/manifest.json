{
  "manifestVersion": 5,
  "id": "org.opencatalog.indesign",
  "name": "OpenCatalog",
  "version": "0.5.0",
  "main": "index.html",
  "host": {
    "app": "ID",
    "minVersion": "18.5.0"
  },
  "entrypoints": [
    {
      "type": "panel",
      "id": "opencatalogPanel",
      "label": {
        "default": "OpenCatalog"
      },
      "minimumSize": {
        "width": 320,
        "height": 300
      },
      "maximumSize": {
        "width": 2400,
        "height": 2400
      },
      "preferredDockedSize": {
        "width": 420,
        "height": 600
      },
      "preferredFloatingSize": {
        "width": 720,
        "height": 600
      }
    }
  ],
  "requiredPermissions": {
    "localFileSystem": "request",
    "network": {
      "domains": "all"
    },
    "allowCodeGenerationFromStrings": true
  }
}
